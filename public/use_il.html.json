ue},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"window.location.href='/'\" \r\nstyle=\"background-color:transparent;border:none;box-shadow:none\">\r\n\r\n<img width=\"178\" height=\"100\" src=\"LOGO%20small.png\" alt=\"logo\">\r\n</button>\r\n"},{"id":"silex-id-1604063015245-7","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{"height":"470px","top":"-42px","left":"-5px","width":"429px"},"desktop":{"width":"753px","height":"193px","position":"absolute","top":"111px","left":"1px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<p>\n\nקלפים טיפוליים מאפשרים עוד מרחב למטפל והמטופל. אין צורך להוריד את הקלפים, האתר נפתח במהירות. מאפשר עבודה משותפת על אותו המסך מרחוק, בקלילות! גם אם אתם ממש חוששים מכלים טכנולוגיים, תופתעו לגלות עד כמה העבודה היא פשוטה ונעימה.<br>הסשנים נשמרים באתר ואין צורך לשמור במקום נוסף! ועוד- ניתן להדפיס את תוצרי העבודה, לשמור אותם כ PDF ולהדפיס את לוח הקלפים.<br>הכלים שיצרנו עבור קהילת המטפלים והמאמנים עכשיו בחודש התנסות ללא עלות\n\n</p>"},{"id":"silex-id-1604132751349-9","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{"height":"102px","top":"-53px","left":"4px","width":"458px"},"desktop":{"width":"485px","height":"64px","position":"absolute","top":"22.000022888183594px","left":"114px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<h1>\n\nהעבודה עם קלפים וירטואליים\n\n<br></h1>"},{"id":"silex-id-1604518043294-6","type":"text-element","alt":null,"tit