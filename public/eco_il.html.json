ent","position":"absolute","top":"5.3833394050598145px","left":"93.98369216918945px","opacity":null}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"goBack()\" \r\nstyle=\"background-color:transparent;border:none;box-shadow:none\">\r\n\r\n<img width=\"178\" height=\"100\" src=\"LOGO%20small.png\" alt=\"logo\">\r\n</button>\r\n<script>\r\nfunction goBack() {\r\n  window.history.back();\r\n}\r\n</script>"},{"id":"silex-id-1604063015245-7","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"977px","height":"756px","position":"absolute","top":"637.5166168212891px","left":"1425.2833251953125px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<h2>הנחיות לטיפול תרופתי / טיפולי טבע</h2>הטבע פועל כשותף טיפולי, יכול להיות לו תפקיד פעיל ולא רק תפאורה יפה. הסיפון לטיפול אקולוגי יכול להציע הזדמנות עוצמתית לשלב את הטבע בעבודה הטיפולית שלנו - גם כשאנחנו עובדים מרחוק.<br>להלן כמה רעיונות שאולי תרצה לנסות. ישנם שילובים רבים עם חפיסות אחרות שעשויות להיות יעילות ביותר. ניסוי, שחק עם הקלפים ובדוק אם תוכל למצוא דרך חדשה לעבוד איתם.<br>שמי:<br>עיין בתמונות השונות, ייתכן שתגלה שזה הכי קל כשאתה מפיץ את כל הכרטיס. נסה למצוא סוג שמייצג את מי שאתה, כרטיס שאתה יכול לזהות את עצמך ככזה. אולי זה עץ, או אפילו חלק מסוים של העץ. מה מהדהד בתוכך? אילו רגשות מופיעים? האם אתה יכול לתת לעצמך שם על סמך התמונה שבחרת?<br><br>המקום הבטוח שלי:<br>\"מקום בטוח *\" יכול להיחשב מקום קדוש לרגשות, מקום שאליו אנו יכולים להיכנס לנוחות כאשר אנו מרגישים לחוצים. לאחר שלמדנו לבנות או לזהות \"מקום בטוח\", נוכל להחיות את זיכרון הכספת. מקום ודמיין להיות שם בתקופות מטרידות.<br>בחר 1-3 קלפים שמרגישים בטוחים עבורך. נסה לבנות ייצוג חזותי של אותו מקום. עיין כעת בתמונות ובדוק אם יש עוד משהו שתרצה להוסיף ל\"מקום הבטוח \"שלך.<br>ייתכן שתרצה להוסיף כרטיסים מחפיסות אחרות, למשל תמונה מחפיסת \"ערכים\" המייצגת את מה שחשוב לך שיהיה או נפל במקום הבטוח שלך.<br>* אם המונח \"מקום בטוח\" מעלה קונוטציות קשות, תוכלו לבחור להשתמש במונח אחר כמו \"מקום של נוחות\".<br>הסניף שלי:<br>לעתים קרובות אנו מוצאים את עצמנו בדילמה, מוטרדים מהחלטות שונות שהחיים מציעים לנו. רוברט פרוסט מציע מטפורה יפה לבחירות בשירו \"הדרך שלא נלקחה\":<br>שני דרכים התפצלו ביער צהוב,<br>וסליחה שלא יכולתי לנסוע בשניהם<br>והיה מטייל אחד, זמן רב עמדתי<br>והסתכל למטה אחד עד כמה שיכולתי<br>לאן שהיא התכופפה בסבך;<br>לאחר קריאת השיר בחר כרטיס המייצג את הדילמה שלך, היכן אתה נמצא כעת. דמיין את עצמך כתמונה המתוארת בכרטיס. נסה להכיר באופציה השונה כחלקים מהתמונה, אולי שני ענפים שונים נובעים. מה עושה כל אחד אילו רגשות אצטרך לקבל אם אבחר בדרך זו?"},{"id":"silex-id-1604524350622-4","type":"section-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"position":"static","margin-top":"-1px","background-color":"rgba(71,67,67,1)"}},"data":{"component":null},"children":["silex-id-1604524350622-5","silex-id-1604062398148-6","silex-id-1604062127123-3"],"pageNames":["page--"],"classList":[],"link":null,"enableEdit":false,"enableDrag":true,"enableDrop":true,"enableResize":{"top":false,"bottom":false,"left":false,"right":false},"selected":false,"useMinHeight":true,"innerHtml":""},{"id":"silex-id-1604524350622-5","type":"container-element","alt":null,"title":null,"isSectionContent":true,"visibility":{"desktop":true,"mobile":true},"style":{"desktop":{"height":"100px","background-color":"rgba(71,67,67,1)","position":"relative","margin-left":"auto","margin-right":"auto"},"mobile":{}},"data":{"component":null},"children":[],"pageNames":[],"classList":["silex-elem