ectionContent":false,"title":"","alt":null,"children":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":false,"visibility":{"desktop":true,"mobile":true},"style":{"desktop":{"width":"463px","height":"407px","background-color":"transparent","top":"56px","left":"0px","position":"absolute"},"mobile":{"height":"407px","top":"0px","left":"0px","width":"460px"}},"data":{"component":{"name":"form1","templateName":"form","data":{"buttonBorderColor":"#B4E5E8","buttonBackgroundColor":"#B4E5E8"}}},"innerHtml":"<form id=\"id_1604523947013_302\" action=\"https://formspree.io/your@email.com\" method=\"POST\" >\n  \n  <div>\n    <label for=\"field1\">Name</label>\n    <input type=\"text\" required id=\"field1\" name=\"field1\" placeholder=\"Your name\">\n  </div>\n  \n  \n  <div>\n    <label for=\"field2\">Your email adress</label>\n    <input type=\"text\" required id=\"field2\" name=\"field2\" placeholder=\"your@email.com\">\n  </div>\n  \n  \n  <div class=\"fill-vertical\">\n    <label for=\"field3\">Your message</label>\n    <textarea required id=\"field3\" name=\"field3\" placeholder=\"What you have to say\"></textarea>\n  </div>\n  \n  <input type=\"submit\" value=\"Send\">\n</form>\n<style>\n#id_1604523947013_302 input[type=text], select {\n    width: 100%;\n    padding: 12px 20px;\n    margin: 8px 0;\n    display: inline-block;\n    border: 1px solid #ccc;\n    border-radius: 3px;\n    box-sizing: border-box;\n}\n\n#id_1604523947013_302 input[type=submit] {\n    width: 100%;\n    background-color: #B4E5E8;\n    color: #FFFFFF;\n    padding: 14px 20px;\n    margin: 8px 0;\n    border: 1px solid #B4E5E8;\n    border-radius: 3px;\n    cursor: pointer;\n}\n#id_1604523947013_302 label {\n    color: #000000;\n}\n/* *************************** */\n/* resize the 3rd field\n   and fill the vertical space */\n#id_1604523947013_302 .fill-vertical {\n    flex: 1 1 auto;\n    display: flex;\n    flex-direction: column;\n}\n#id_1604523947013_302 .fill-vertical textarea {\n    flex: 1 1 auto;\n    width: 100%;\n    height: 150px;\n    padding: 12px 20px;\n    box-sizing: border-box;\n    border: 2px solid #ccc;\n    border-radius: 3px;\n    background-color: #f8f8f8;\n    font-size: 16px;\n    resize: none;\n}\n/* ************************ */\n#id_1604523947013_302 {\n    border-radius: 3px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    height: 100%;\n}\n</style>\n\n"},{"id":"silex-id-1604062398148-6","type":"html-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"245px","height":"105px","background-color":"transparent","position":"absolute","top":"5.616692543029785px","left":"68.5px","opacity":null}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"window.location.href='/'\" \r\nstyle=\"background-color:transparent;border:none;box-shadow:none\">\r\n\r\n<img width=\"178\" height=\"100\" src=\"LOGO%20small.png\" alt=\"logo\">\r\n</button>\r\n"},{"id":"silex-id-1604063015245-7","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"956px","height":"525.8666381835938px","position":"absolute","top":"69px","left":"5px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<p>Digi Card Therapy אתר חדשני המהווה בית תוכן וכלים דיגיטליים למטפלים ומאמנים מגישות שונות. האתר נבנה במיוחד עבור קהילת המטפלים לתקופה המאתגרת כשרבים מהטיפולים מתקיימים מחוץ למרחב הקליניקה, ונערכים מרחוק. בנוסף, האתר מתאים גם לכל המעוניינים בעבודה עצמית. \n\n</p><p><img src=\"https://editor.silex.me/ce/dropbox/get/PROFILE2%20L_180x165(1).png\" alt=\"\" class=\"wysiwyg-float-left\"></p><br><b>אדם לייטון, ממייסדי האתר</b> הוא בעצמו מטפל  מוסמך המוכשר בגישות טיפוליות שונות, בין היתר בגישות  חדשניות ביותר כגון ACT וטיפול בטבע. <br>אחרי שנים &nbsp;קריירה  מספקת, ומתוך רצון להקדיש את כל זמנו לעבודה עם אנשים, עשה אדם הסבה לתחום. טיפולי שמאחד את אהובתיו לאנשים ולטבע. אדם בעל קליניקה משגשגת משקיע את חייו למטופלים ליצירת כלים פרסונליים להתמודדות עם אתגרים ויצירת משמעויות. <br><ul><li>לייטון מייסד ומרצה - \"קורס להכשרת מנחים קבוצתיים מבוסס CBT בשילוב עם עבודה התנסותית בטבע.\"\n\n </li><li>יו\"ר עמותה לטיפול פסיכולוגי ראשוני באנגליה - Heads Up. </li><li>מנחה בעמותת \"בשביל המחר\" - מסעות לסייע לחיילים/ות משוחררים אשר במהלך שירותם הצבאי נחשפו לאירועיים מורכבים וטראומטיים.</li><li>מנחה טיפול במסע והרפתקה מוסמך.</li><li>חבר האגודה הישראלית לטיפול קוגניטיבי התנהגותי בעצימות נמוכה. </li><li>מייסד המרכז לקשר מרחוק יחד עם ד\"ר ארנון רולניק.</li></ul><p><b>מירית שהם, ממייסדי DIGI CARD THERAPY </b><br>מירית מגיעה מעולם התוכן והטלוויזיה ואחראית בDIGI CARD THERAPY על פיתוח התוכן וחווית המשתמש. <br>אנחנו בDIGI CART THERAPY מאמינים ביצירת עולם תוכן כמה שיותר עשיר המאפשר כמה שיותר גמישות לצרכי המטפל. <br>מירית בעלת תואר ראשון בפסיכולוגיה, לומדת לתואר שני בלימודי משפחה במסלול לייעוץ פרטני.<br>מטפלת בטיפול קוגניטיבי התנהגותי (בעצימות נמוכה) במבוגרים.</p>"},{"id":"silex-id-1604132751349-9","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"485px","height":"68px","position":"absolute","top":"16px","left":"321.2666473388672px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"le