995117px","left":"1356px","opacity":"0.5"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"goBack()\">Back to <p>Digi Card Therapy</p></button>\r\n<script>\r\nfunction goBack() {\r\n  window.history.back();\r\n}\r\n</script>"},{"id":"silex-id-1604062398148-6","type":"html-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"245px","height":"105px","background-color":"transparent","position":"absolute","top":"5.3833394050598145px","left":"93.98369216918945px","opacity":null}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"goBack()\" \r\nstyle=\"background-color:transparent;border:none;box-shadow:none\">\r\n\r\n<img width=\"178\" height=\"100\" src=\"LOGO%20small.png\" alt=\"logo\">\r\n</button>\r\n<script>\r\nfunction goBack() {\r\n  window.history.back();\r\n}\r\n</script>"},{"id":"silex-id-1604063015245-7","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"977px","height":"1027px","position":"absolute","top":"107.03342914581299px","left":"361.7000427246094px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<h1><b>Instrucciones de la Baraja de Terapia\nEco/Natural</b></h1>\n\n<p>La naturaleza actúa como socio\nterapéutico. Puede tener un rol activo - no solo un entorno hermoso. La baraja\nde eco-terapia puede ofrecer una poderosa oportunidad para integrar la\nnaturaleza en nuestro trabajo terapéutico - incluso cuando trabajamos de forma\nremota. </p>\n\n<p>A continuación se muestran algunas ideas\nque quizás desees probar. Hay numerosas combinaciones con otras barajas que\ntambién podrías encontrar muy efectivas. Experimenta, juega con las cartas y ve\nsi puedes encontrar una nueva forma de trabajar con ellas.</p>\n\n<p><b>Mi nombre es:</b></p>\n\n<p>Echa una ojeada a través de las diferentes\nimágenes, puedes encontrar que es más fácil cuando extiendes todas las cartas.\nIntenta encontrar un tipo que represente quién eres, una carta con la que puedas\nidentificarte. Tal vez sea un árbol, o incluso una parte particular del árbol. ¿Qué\nresuena dentro de ti? ¿Qué emociones aparecen? ¿Podrías darte un nombre basado\nen la imagen que has seleccionado?</p>\n\n<p><b>Mi lugar seguro:</b></p>\n\n<p>Un \"lugar seguro *\" puede\nconsiderarse un lugar sagrado para las emociones, un lugar al que podemos\nentrar en busca de comodidad cuando nos sentimos estresados. Una vez que\naprendemos a construir o reconocer un \"lugar seguro\", podemos\nintentar revivir el recuerdo del lugar seguro e imaginar que estamos allí\ndurante tiempos difíciles.</p>\n\n<p>Elija entre 1- 3 cartas que te resulten seguras.\nIntenta construir una representación visual de ese lugar. Ahora echa otro\nvistazo a las imágenes y ve si hay algo más que te gustaría agregar a tu\n\"lugar seguro\".</p>\n\n<p>Podrías querer agregar cartas de otras\nbarajas, por ejemplo, una imagen del mazo de \"Valores\" que represente\nlo que, para ti, sea importante tener o sentir en tu lugar seguro.</p>\n\n<p>* Si el término \"lugar seguro\"\ntiene connotaciones difíciles, puedes optar por usar un término diferente, como\n\"lugar de comodidad\".</p>\n\n<p><b>Mi rama:</b></p>\n\n<p>A menudo nos encontramos en un dilema,\npreocupados por varias decisiones que la vida nos ofrece. Robert Frost ofrece\nuna hermosa metáfora de las opciones en su poema \"The Road Not Taken\"\n(“El Camino No Tomado):</p>\n\n<p><i>Dos caminos divergieron en un bosque\namarillo,</i></p>\n\n<p><i>Y lo siento no pude viajar ambos</i></p>\n\n<p><i>Y ser un viajero, durante mucho tiempo me\nquedé</i></p>\n\n<p><i>Y miré hacia abajo uno tan lejos como\npude</i></p>\n\n<p><i>A donde se inclinó en la maleza;</i></p>\n\n<p>Después de leer el poema, escoge una carta\nque represente tu dilema, dónde te encuentras ahora. Imagínate como la imagen mostrada\nen la carta. Trata de &nbsp;reconocer la\nopción diferente como partes de la imagen, quizá dos ramas diferentes que\nsalen. ¿Cómo se siente cada rama? ¿Qué emociones tendré que aceptar si escojo esa\nruta?</p>\n\n<p>&nbsp;</p>\n\n\n\n\n\n"},{"id":"silex-id-1604524350622-4","type":"section-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"position":"static","margin-top":"-1px","background-color":"rgba(71,67,67,1)"}},"data":{"component":null},"children":["silex-id-1604524350622-5","silex-id-1604062398148-6","silex-id-1604062127123-3"],"pageNames":["page-baraja-de-terapia-eco-natural"],"classList":[],"link":null,"enableEdit":false,"enableDrag":true,"enableDrop":true,"enableResize":{"top":false,"bottom":false,"left":false,"right":false},"selected":false,"useMinHeight":true,"innerHtml":""},{"id":"silex-id-1604524350622-5","type":"container-element","alt":null,"title":null,"isSectionContent":true,"visibility":{"desktop":true,"mobile":true},"style":{"desktop":{"height":"100px","background-color":"rgba(71,67,67,1)","position":"relative","margin-left":"auto","margin-right":"auto"},"mobile":{}},"data":{"component":null},"children":[],"pageNames":[],"classList":["silex-element-content","website-width","prevent-draggable"],"link":null,"enableEdit":false,"enableDrag":false,"enableDrop":true,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":""}]}