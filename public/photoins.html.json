604061761094-2","type":"container-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{"height":"117px","top":"-125px","left":"2px","width":"438px"},"desktop":{"width":"2501px","height":"117px","background-color":"rgba(71,67,67,1)","position":"absolute","top":"0px","left":"-15px"}},"data":{"component":null},"children":["silex-id-1604062398148-6","silex-id-1604062127123-3"],"pageNames":[],"classList":[],"link":null,"enableEdit":false,"enableDrag":true,"enableDrop":true,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":""},{"id":"silex-id-1604062127123-3","type":"html-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"149px","height":"74px","background-color":"transparent","position":"absolute","top":"24px","left":"1418px","opacity":"0.5"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"goBack()\">Back to <p>Digi Card Therapy</p></button>\r\n<script>\r\nfunction goBack() {\r\n  window.history.back();\r\n}\r\n</script>"},{"id":"silex-id-1604062398148-6","type":"html-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"245px","height":"105px","background-color":"transparent","position":"absolute","top":"4px","left":"27px","opacity":null}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"<button onclick=\"goBack()\" \r\nstyle=\"background-color:transparent;border:none;box-shadow:none\">\r\n\r\n<img width=\"178\" height=\"100\" src=\"LOGO%20small.png\" alt=\"logo\">\r\n</button>\r\n<script>\r\nfunction goBack() {\r\n  window.history.back();\r\n}\r\n</script>"},{"id":"silex-id-1604063015245-7","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"358px","height":"1820px","position":"absolute","top":"93px","left":"327px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"\n\n\n\n<p>תמונה אחת שווה אלף מילים...לפעמים\nהיא שווה רק מילה אחת &nbsp;לפעמים כמה. תמונה יכולה\nלתאר &nbsp;במדויק מצב שהמילים חמקו ממנו,\nלפעמים היא מעוררת חלום, אמונה, מזכירה מה חשוב.<br></p>\n\n<p>תמונה מסוגלת להקפיץ למודעות מחשבות,\nאמונות, רגשות שמילים לא הצליחו לשלוף.</p>\n\n<p>אותה תמונה תגיד לכל אחד משהו אחר\nלגמרי, זאת תזכורת טובה לא להניח מה האחר חושב, \nשנקודות מבט שדרכן אנחנו מסתכלים על העולם הן שונות.</p>\n\n<h2>&nbsp;איך משחקים בקלפי תמונות? איך שתרצו!</h2>\n\n<p>הנה כמה רעיונות שלנו</p>\n\n<ul><li>&nbsp;בחר קלף המתאר את המצב שבו אתה נמצא\nכעת</li><li>בחר קלף המתאר &nbsp;מקום שאתה רוצה להיות בו</li><li>בחר קלף המתאר את העתיד שלך כפי שאתה\nחולם עליו</li><li>בחר קלף המייצג בעיה שאתה מתמודד איתה\nכרגע?</li><li>בחר קלף שיכול לייצג פתרון לבעיה</li><li>בחר קלף המתאר את הרגש שמתעורר כתוצאה\nמהבעיה שאתה מתמודד איתה?</li><li>האם יש קלף המתאר את הדרך בה אתה רוצה\nלנהוג</li><li>איזה קלף מעורר בך מוטיבציה? מה אתה\nרואה שם</li><li>בחר קלף משמעותי עבורך, מה הוא מעורר\nבך?</li><li>איזה קלף משמח אותך? מה יש בו?</li><li>איזה קלף מייצג עבורך מערכת יחסים\nמשמעותית? מה קיים בו?</li><li>בחר קלף המעורר בך השראה</li><li>בחר קלף המתאר דפוס מסוים שבו אתה\nנוהג</li><li>בחר קלף המתאר מקום בטוח וחיובי עבורך</li><li>בחר קלף המתאר את החוזקות והמשאבים\nשלך</li><li>בחר קלף שמייצג עמדה שמעכבת אותך</li><li>בחר קלף שמחולל בך אנרגיה לעשייה\nוהתמודדות</li><li>בחר קלף המייצג עבורך התחלה חדשה</li><li>בחר קלף המייצג את השינוי שברצונך\nלעשות<h3></h3></li></ul><h3>סיפור באמצעות תמונות</h3><p>בחרו 5-9 קלפים ובעזרתם ספרו סיפור. במה הסיפור / הדמות בסיפור דומה לך? במה שונה? <br></p><p>אפשר לנסות לבחון יחד האם הסיפור יכול להתפתח אחרת? מה צריך לקרות בשביל זה?</p>\n\n\n\n\n\n\n\n\n\n"},{"id":"silex-id-1604420896457-0","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"322px","height":"3324px","position":"absolute","top":"77px","left":"-1px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"\n\n\n\n<h3>בחפיסה יש שני רקעים נוספים שניתן להעזר בהם,</h3><ul><li>בול פגיעה</li><li>מטריצה</li></ul><p>בבול פגיעה נוכל להשתמש לייצג מצב נוכחי לאומת רצוי. לבחור 5 קלפים שמייצגים את הזוגיות שלי, ולאחר מכן לשבץ בבול פגיעה. המרכז מייצג שאני נמצא היכן שאני רוצה להיות וככל שמתרחקים מהמרכז – אני נמצא רחוק מהמקום שאני רוצה להיות בו.</p><p>המטריצה אפשר להשתמש למיון. מיון מסייע להכרה והבחנה בין נקודות מבט. ניתן להשתמש ברקע 'המטריצה' ולמיין לפי קטגוריות שונות . למשל 1. מה חשוב לך 2. תחושות, מחשבות, תחושות או זיכרונות [דברים פנימיים] המופיעים כשאתה שוקל על מה שחשוב. 3. מה אתה עושה על מנת להימנע מהתחושות/ מחשבות/ רגשות הללו 4. איך תגיב – כשלמחשבות/ רגשות/ אמונות האלה לא תהיה השפעה עליך .</p><p>&nbsp;</p><h2>קומבינציות של חפיסות: (תמונות, ערכים, ציטוטים)</h2><p>צור לעצמך לוח חזון!</p><p>מה זה חזון? חזון &nbsp;הוא תמונה שאדם רואה בעיני רוחו, בדמיונו, בחלומו.</p><p>חזון הוא המקום שאליו נרצה להגיע. המקום הטוב ביותר שנוכל לדמיין עבור עצמנו בכל היבטי החיים או בתחומים ספציפיים. כדי להגיע אליו, כדאי לפני הכל...להגדיר אותו, בצורה ברורה ובהירה, ממש לראות בעיני רוחנו את הדמיון הטוב ביותר שלנו-</p><p>איך זה נראה? מה יהיה שם? איך ייראה הבית שלנו? איך יהיו מערכות היחסים המשמעותיות שלנו? אילו נכסים יהיו לנו (רוחניים, אישיותיים, כלכליים).</p><p>דמיינו אתכם בחזונכם לפרטי פרטים! כתבו אותו בהזדמנות ואחת לכמה זמן תעדכנו אותו.</p><p>כשיש לך חזון, קל &nbsp;יותר למצוא את הדרכים להגיע לשם, את המוטיבציה והדלק לנסיעה הארוכה.</p><p>בחר ערכים, ציטוט ותמונה שיתארו את המקום בו תרצה להיות ואת הדרך בה תרצה להגיע לשם</p><p>אף פעם לא מזיק להדפיס ולתלות מול העיניים לתזכורת יומיומיתJ</p>\n\n\n\n"},{"id":"silex-id-1604420973126-1","type":"text-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"312px","height":"60px","position":"absolute","top":"11px","left":"170px"}},"data":{"component":null},"children":[],"pageNames":[],"classList":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"innerHtml":"\n\n<h1>קלפי תמונות</h1>\n\n"}]}